# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Required ---------------------------------------------------------------
# FoxESS Cloud -> User Profile -> API Management -> Generate API key
FOXESS_API_KEY=

# --- API ---------------------------------------------------------------------
# Geo-steered by FoxESS; EU traffic lands in Alibaba DE. Change only if needed.
FOXESS_API_BASE=https://www.foxesscloud.com
# Optional. Leave blank to auto-discover via /op/v0/device/list.
# Comma-separate for multiple inverters.
FOXESS_DEVICE_SN=

# --- Server ------------------------------------------------------------------
PORT=8080
# 0.0.0.0 lets you view it from a phone on the LAN; 127.0.0.1 locks it to the laptop.
HOST=0.0.0.0
# Drives "today" boundaries and the displayed clock.
TZ=Europe/London

# --- Polling schedule --------------------------------------------------------
# Budget is 1440 API calls/day PER INVERTER. Defaults below total 1276/day (89%).
# The server refuses to start if the projected total exceeds DAILY_CALL_BUDGET.
POLL_REAL_SECONDS=90
POLL_TOTALS_SECONDS=600
POLL_QUOTA_SECONDS=3600
# How often to RE-READ the battery's minimum SOC. This does not set it -- min SOC lives on the
# inverter and is changed in the FoxESS app; this dashboard is read-only and only reports it.
# It rarely changes, so six-hourly is ample: 4 calls/day. Skipped on an inverter with no battery.
POLL_SETTINGS_SECONDS=21600
DAILY_CALL_BUDGET=1400

# Drop to a slower poll when nobody is watching (kiosk screen off), snap back on connect.
IDLE_SLOWDOWN_SECONDS=900
IDLE_POLL_SECONDS=300

# --- Battery ------------------------------------------------------------------
# Your pack's total capacity in kWh, from the installer's invoice or the FoxESS app
# (e.g. an EQ4800-L6 is 27.96). Optional, but AUTHORITATIVE when set.
#
# Why it matters: on some packs the API's `ResidualEnergy` variable is not remaining energy at all.
# One EQ4800-L6 reported 26.9 kWh at 68% SOC on a 27.96 kWh pack, while the FoxESS app correctly
# showed 19.01 (= 27.96 x 0.68). With this set, stored energy is computed as capacity x SOC and
# matches the app; leave it unset and `ResidualEnergy` is used as before.
#
# Run `npm run probe` — it prints these figures and warns if they disagree.
BATTERY_CAPACITY_KWH=

# --- Storage & logging -------------------------------------------------------
DATA_DIR=./data
RETAIN_DAYS=14
LOG_LEVEL=info
# auto = human-readable on a TTY, one-line JSON under systemd
LOG_PRETTY=auto

# --- Development -------------------------------------------------------------
# 1 = serve synthetic data, make ZERO real API calls. Use this for all UI work.
FOXESS_MOCK=0
# Shift the simulated clock, in hours. Lets you target a specific time of day while working on the
# UI -- midday export, evening discharge, a low overnight SOC -- instead of whatever hour it is.
# Mock mode only.
MOCK_OFFSET_HOURS=0
