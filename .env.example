# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Required ---------------------------------------------------------------
# FoxESS Cloud -> User Profile -> API Management -> Generate API key
FOXESS_API_KEY=

# --- API ---------------------------------------------------------------------
# Geo-steered by FoxESS; EU traffic lands in Alibaba DE. Change only if needed.
FOXESS_API_BASE=https://www.foxesscloud.com
# Optional. Leave blank to auto-discover via /op/v0/device/list.
# Comma-separate for multiple inverters.
FOXESS_DEVICE_SN=

# --- Server ------------------------------------------------------------------
PORT=8080
# 0.0.0.0 lets you view it from a phone on the LAN; 127.0.0.1 locks it to the laptop.
HOST=0.0.0.0
# Drives "today" boundaries and the displayed clock.
TZ=Europe/London

# --- Polling schedule --------------------------------------------------------
# Budget is 1440 API calls/day PER INVERTER. Defaults below total 1276/day (89%).
# The server refuses to start if the projected total exceeds DAILY_CALL_BUDGET.
POLL_REAL_SECONDS=90
POLL_TOTALS_SECONDS=600
POLL_QUOTA_SECONDS=3600
# Battery minimum-SOC settings. They only change when you change them in the FoxESS app, so
# six-hourly is ample -- 4 calls/day. Skipped entirely on an inverter with no battery.
POLL_SETTINGS_SECONDS=21600
DAILY_CALL_BUDGET=1400

# Drop to a slower poll when nobody is watching (kiosk screen off), snap back on connect.
IDLE_SLOWDOWN_SECONDS=900
IDLE_POLL_SECONDS=300

# --- Storage & logging -------------------------------------------------------
DATA_DIR=./data
RETAIN_DAYS=14
LOG_LEVEL=info
# auto = human-readable on a TTY, one-line JSON under systemd
LOG_PRETTY=auto

# --- Development -------------------------------------------------------------
# 1 = serve synthetic data, make ZERO real API calls. Use this for all UI work.
FOXESS_MOCK=0
# Shift the simulated clock, in hours. Lets you target a specific time of day while working on the
# UI -- midday export, evening discharge, a low overnight SOC -- instead of whatever hour it is.
# Mock mode only.
MOCK_OFFSET_HOURS=0
